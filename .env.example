ACME_EMAIL="your-email@example.com"

# Cloudflare API token
# 必要權限：
#   - Zone:DNS:Edit       （install_acme.sh / install_wildcard_ssl.sh 簽 wildcard 證；webops cf-dns 增刪 record）
#   - Zone:Zone:Read（選） （webops 在 domains.conf 留空 zone_id 時 auto-discover；不用此功能可省）
# 範圍建議：限縮到實際管理的 zones，不要用 Global API Key。
CF_Token="your_cloudflare_token"

# Optional: certificate install path (default: /etc/nginx/ssl)
# SSL_DIR="/etc/nginx/ssl"

# === 資料庫備份設定（backup_databases.sh） ===
# 注意：若密碼含空格或特殊字元（# " ' $ 等），.env 載入會失敗。
#       請避免特殊字元，或使用 base64/僅英數的密碼。

# MariaDB 連線
DB_USER="backup_user"
DB_PASS="your_db_password"
# DB_HOST="localhost"

# 備份路徑（建議放在獨立掛載碟，保護系統碟空間）
BACKUP_DIR="/mnt/your-mount/bakdb/backups"
BACKUP_LOG_DIR="/mnt/your-mount/bakdb/logs"
BACKUP_MOUNT_POINT="/mnt/your-mount"

# 要備份的項目（空格分隔）。每個項目可指定整個 DB 或部分資料表：
#   db_name              → 整個資料庫
#   db_name:t1           → 該 DB 的單一資料表
#   db_name:t1,t2,t3     → 該 DB 的多張表（同一份輸出檔）
# 同一個 DB 可重複出現以拆出不同表組（會分別產生獨立檔案）。
# 範例：BACKUP_DBS="voxy global_voxy:users global_voxy:lessons,orders"
BACKUP_DBS="db_one db_two:table_a,table_b"

# （選填）要備份的 PostgreSQL 項目，語法同 BACKUP_DBS（db 或 db:t1,t2）。
# 以 postgres 系統帳號 peer 認證執行 pg_dump，不使用 DB_USER / DB_PASS；表名原樣傳給 pg_dump -t
# （非 public schema 請寫 schema.table）。輸出檔名加 pg_ 前綴。
# 只備份 PostgreSQL 時可不設 BACKUP_DBS / DB_USER / DB_PASS（兩者至少要設一個）。
# BACKUP_PG_DBS=""

# 舊檔保留天數（預設 30）
# BACKUP_RETENTION_DAYS=30

# === webops 部署框架 ===
# 主網域註冊表在 webops/domains.conf（gitignore，含 zone_id）
# CF_Token 重用上方 install_acme.sh 的設定（需對 domains.conf 內所有 zone 有 Zone:DNS:Edit）

# 站點根目錄（deploy-site.sh 部署位置；laravel-svc.sh 也讀此值）
WEBOPS_BASE_DIR="/home/svc-app/public_html"

# 站點檔案 owner（svc-app 可改檔；nginx www-data 群組可讀）
WEBOPS_USERNAME="svc-app"

# SSL 憑證路徑（預設 = 上方 SSL_DIR；通常 /etc/nginx/ssl）
# WEBOPS_SSL_PATH="/etc/nginx/ssl"

# PHP-FPM socket（不設則自動偵測 /run/php/php*-fpm.sock 取最新版）
# WEBOPS_PHP_FPM_SOCK="/run/php/php8.3-fpm.sock"

# deploy-site 第 9 步「順便建庫」使用的資料庫引擎：mariadb（預設；未設/空值/無效值皆 mariadb）
# 或 postgresql（別名 pgsql、postgres；以 postgres 系統帳號 peer 認證，需先 apt install postgresql）。
# MODE=wordpress 不支援 PostgreSQL，一律改用 MariaDB。
# WEBOPS_DB_ENGINE=mariadb

# 本機公網 IP（選填；逗號分隔可多個，v4/v6 混用）。
# 用途：cf-dns ls / 進階選單刪子網域 預設只列指向本機的記錄；cf-dns add 未指定 IP 時的預設值。
# 留空 → 自動用 ipv4.icanhazip.com 偵測。
# WEBOPS_SERVER_IP=

# webops 啟動畫面停留秒數（預設 1；任意鍵可立即進入；設 0 = 完全跳過 splash）
# WEBOPS_SPLASH_SECONDS=1

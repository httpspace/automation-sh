# =====================================================================
# automation-sh 設定範本
# 使用方式：cp .env.example .env，填好「必填」區，其餘需要時再取消註解。
# 註解掉的項目 = 使用程式內建預設值（或不啟用該功能）。
#
# 注意：.env 以 xargs 載入，值不可含空格或特殊字元（# " ' $ 等），
#       密碼請用僅英數的字串。多個值的項目（如 BACKUP_DBS）見各區說明。
# =====================================================================


# === 必填：SSL 憑證（install_acme.sh / install_wildcard_ssl.sh） ===

# Let's Encrypt 註冊信箱
ACME_EMAIL="your-email@example.com"

# Cloudflare API token
# 必要權限：
#   - Zone:DNS:Edit        （簽 wildcard 憑證；webops cf-dns 增刪 record）
#   - Zone:Zone:Read（選）  （webops 在 domains.conf 留空 zone_id 時自動查詢；不用此功能可省）
# 範圍建議：限縮到實際管理的 zones，不要用 Global API Key。
CF_Token="your_cloudflare_token"

# 憑證安裝路徑（預設 /etc/nginx/ssl）
# SSL_DIR="/etc/nginx/ssl"


# === 選填：資料庫備份（backup_databases.sh） ===
# 有用 backup_databases.sh 才需要設定，整區預設不啟用。
# 啟用時必填：BACKUP_DIR、BACKUP_LOG_DIR、BACKUP_MOUNT_POINT，
#             以及 BACKUP_DBS / BACKUP_PG_DBS 至少一個（都沒設會直接報錯停止）。

# 備份路徑（建議放在獨立掛載碟；BACKUP_MOUNT_POINT 未掛載時會中止，保護系統碟）
# BACKUP_DIR="/mnt/your-mount/bakdb/backups"
# BACKUP_LOG_DIR="/mnt/your-mount/bakdb/logs"
# BACKUP_MOUNT_POINT="/mnt/your-mount"

# MariaDB 備份項目（空格分隔）。每個項目可指定整個 DB 或部分資料表：
#   db_name              → 整個資料庫
#   db_name:t1           → 該 DB 的單一資料表
#   db_name:t1,t2,t3     → 該 DB 的多張表（同一份輸出檔）
# 同一個 DB 可重複出現以拆出不同表組（會分別產生獨立檔案）。
# 範例：BACKUP_DBS="shop blog:users blog:posts,comments"
# BACKUP_DBS=""

# MariaDB 連線帳密（設了 BACKUP_DBS 才需要）
# DB_USER="backup_user"
# DB_PASS="your_db_password"
# DB_HOST="localhost"

# PostgreSQL 備份項目，語法同 BACKUP_DBS（db 或 db:t1,t2）。
# 以 postgres 系統帳號 peer 認證執行 pg_dump，不使用 DB_USER / DB_PASS；
# 表名原樣傳給 pg_dump -t（非 public schema 請寫 schema.table）。輸出檔名加 pg_ 前綴。
# 主機需已安裝 PostgreSQL（webops 不會自動安裝）。
# BACKUP_PG_DBS=""

# 舊檔保留天數（預設 30）
# BACKUP_RETENTION_DAYS=30


# === 選填：webops 部署框架（install_webops.sh / webops 指令） ===
# 主網域註冊表在 webops/domains.conf（gitignore，含 zone_id）。
# CF_Token 共用上方設定（需對 domains.conf 內所有 zone 有 Zone:DNS:Edit）。

# 站點根目錄（deploy-site 部署位置；laravel-svc 也讀此值）。預設 /home/svc-app/public_html
# WEBOPS_BASE_DIR="/home/svc-app/public_html"

# 站點檔案 owner（該帳號可改檔；nginx www-data 群組可讀）。預設 svc-app
# WEBOPS_USERNAME="svc-app"

# SSL 憑證路徑（預設 = SSL_DIR，通常 /etc/nginx/ssl）
# WEBOPS_SSL_PATH="/etc/nginx/ssl"

# PHP-FPM socket（不設則自動偵測 /run/php/php*-fpm.sock 取最新版）
# WEBOPS_PHP_FPM_SOCK="/run/php/php8.3-fpm.sock"

# deploy-site 第 9 步「順便建庫」的資料庫引擎：mariadb（預設；未設/空值/無效值皆 mariadb）
# 或 postgresql（別名 pgsql、postgres；以 postgres 系統帳號 peer 認證，需先自行 apt install postgresql）。
# MODE=wordpress 不支援 PostgreSQL，一律改用 MariaDB。
# WEBOPS_DB_ENGINE=mariadb

# 只在 postgresql 引擎生效：建 PG 庫時用 createdb -O 指定擁有者（免手動 ALTER OWNER）。
# role 需事先手動建立（CREATE ROLE <name> LOGIN PASSWORD '...';），不存在時不會建庫。
# 未設 = 擁有者維持 postgres。
# WEBOPS_PG_DB_OWNER="app_user"

# 本機公網 IP（逗號分隔可多個，v4/v6 混用）。
# 用途：cf-dns ls / 進階選單刪子網域 預設只列指向本機的記錄；cf-dns add 未指定 IP 時的預設值。
# 未設 → 自動用 ipv4.icanhazip.com 偵測。
# WEBOPS_SERVER_IP=

# webops 啟動畫面停留秒數（預設 1；任意鍵可立即進入；設 0 = 完全跳過）
# WEBOPS_SPLASH_SECONDS=1
